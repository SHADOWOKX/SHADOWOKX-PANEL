<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="shadow-panel">
  <schema id="org.gnome.shell.extensions.shadow-panel" path="/org/gnome/shell/extensions/shadow-panel/">
    <key name="debug" type="b">
      <default>false</default>
      <summary>Enable redacted debug logging</summary>
    </key>
    <key name="panel-placement" type="s">
      <choices>
        <choice value="left"/>
        <choice value="center"/>
        <choice value="right"/>
      </choices>
      <default>'right'</default>
      <summary>Top bar placement</summary>
    </key>
    <key name="show-codex-icon" type="b">
      <default>true</default>
      <summary>Show the ChatGPT icon in the top bar</summary>
    </key>
    <key name="show-codex-remaining" type="b">
      <default>true</default>
      <summary>Show weekly remaining capacity in the top bar</summary>
    </key>
    <key name="show-codex-reset-countdown" type="b">
      <default>false</default>
      <summary>Show the weekly reset countdown in the top bar</summary>
    </key>
    <key name="show-weather-icon" type="b">
      <default>true</default>
      <summary>Show the current weather icon in the top bar</summary>
    </key>
    <key name="show-weather-temperature" type="b">
      <default>true</default>
      <summary>Show the current temperature in the top bar</summary>
    </key>
    <key name="show-weather-condition" type="b">
      <default>false</default>
      <summary>Show the current weather condition in the top bar</summary>
    </key>
    <key name="remember-last-tab" type="b">
      <default>true</default>
      <summary>Remember the last selected page</summary>
    </key>
    <key name="last-selected-tab" type="s">
      <default>'codex'</default>
      <summary>Last selected page</summary>
    </key>
    <key name="default-tab" type="s">
      <choices>
        <choice value="codex"/>
        <choice value="weather"/>
      </choices>
      <default>'codex'</default>
      <summary>Default page</summary>
    </key>
    <key name="refresh-on-open" type="b">
      <default>true</default>
      <summary>Refresh stale providers when opening the popup</summary>
    </key>
    <key name="animations" type="b">
      <default>true</default>
      <summary>Enable subtle interface animations</summary>
    </key>
    <key name="density" type="s">
      <choices>
        <choice value="compact"/>
        <choice value="comfortable"/>
      </choices>
      <default>'comfortable'</default>
      <summary>Popup density</summary>
    </key>
    <key name="panel-width" type="s">
      <choices>
        <choice value="narrow"/>
        <choice value="standard"/>
        <choice value="wide"/>
      </choices>
      <default>'standard'</default>
      <summary>Dashboard width</summary>
    </key>
    <key name="theme" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="dark"/>
        <choice value="light"/>
      </choices>
      <default>'auto'</default>
      <summary>Interface color scheme</summary>
    </key>
    <key name="background-theme" type="s">
      <choices>
        <choice value="claude-gray"/>
        <choice value="graphite"/>
        <choice value="gnome"/>
        <choice value="light-neutral"/>
      </choices>
      <default>'claude-gray'</default>
      <summary>Dashboard surface treatment</summary>
    </key>
    <key name="accent-color" type="s">
      <choices>
        <choice value="purple"/>
        <choice value="blue"/>
        <choice value="cyan"/>
        <choice value="emerald"/>
        <choice value="orange"/>
        <choice value="rose"/>
        <choice value="graphite"/>
        <choice value="custom"/>
      </choices>
      <default>'rose'</default>
      <summary>Accent color preset</summary>
    </key>
    <key name="custom-accent" type="s">
      <default>'#f43f5e'</default>
      <summary>Custom accent color</summary>
    </key>
    <key name="show-codex-weekly" type="b">
      <default>true</default>
      <summary>Show the weekly usage limit</summary>
    </key>
    <key name="show-codex-five-hour" type="b">
      <default>true</default>
      <summary>Show the five-hour usage window</summary>
    </key>
    <key name="show-codex-reset-time" type="b">
      <default>true</default>
      <summary>Show reset countdowns and dates</summary>
    </key>
    <key name="show-codex-token-lifetime" type="b">
      <default>true</default>
      <summary>Show lifetime token usage</summary>
    </key>
    <key name="show-codex-token-stats" type="b">
      <default>true</default>
      <summary>Show token activity statistics and history</summary>
    </key>
    <key name="show-codex-insights" type="b">
      <default>true</default>
      <summary>Show supported Codex usage insights</summary>
    </key>
    <key name="codex-refresh-minutes" type="i">
      <range min="5" max="120"/>
      <default>15</default>
      <summary>Codex refresh interval in minutes</summary>
    </key>
    <key name="weather-location" type="s">
      <default>'Cairo, Egypt'</default>
      <summary>Weather location</summary>
    </key>
    <key name="weather-unit" type="s">
      <choices>
        <choice value="celsius"/>
        <choice value="fahrenheit"/>
      </choices>
      <default>'celsius'</default>
      <summary>Temperature unit</summary>
    </key>
    <key name="weather-wind-unit" type="s">
      <choices>
        <choice value="kmh"/>
        <choice value="mph"/>
      </choices>
      <default>'kmh'</default>
      <summary>Wind speed unit</summary>
    </key>
    <key name="weather-refresh-minutes" type="i">
      <range min="15" max="180"/>
      <default>30</default>
      <summary>Weather refresh interval in minutes</summary>
    </key>
    <key name="show-weather-feels-like" type="b">
      <default>true</default>
      <summary>Show feels-like temperature</summary>
    </key>
    <key name="show-weather-humidity" type="b">
      <default>true</default>
      <summary>Show humidity</summary>
    </key>
    <key name="show-weather-wind" type="b">
      <default>true</default>
      <summary>Show wind speed</summary>
    </key>
    <key name="show-weather-rain" type="b">
      <default>true</default>
      <summary>Show rain probability</summary>
    </key>
    <key name="show-weather-uv" type="b">
      <default>true</default>
      <summary>Show the UV index</summary>
    </key>
    <key name="show-weather-sun-times" type="b">
      <default>true</default>
      <summary>Show sunrise and sunset</summary>
    </key>
    <key name="show-weather-insights" type="b">
      <default>true</default>
      <summary>Show deterministic weather insights</summary>
    </key>
  </schema>
</schemalist>
