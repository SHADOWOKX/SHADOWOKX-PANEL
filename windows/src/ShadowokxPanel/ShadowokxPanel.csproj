<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>ShadowokxPanel</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ShadowokxPanel.ico</ApplicationIcon>
    <Platforms>x64;arm64</Platforms>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.9169" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ShadowokxPanel.Core\ShadowokxPanel.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    WinUI adds generated XBF files to the normal build output, but its unpackaged
    .NET integration does not add them to ResolvedFileToPublish. The MRT target
    used by this project also does not publish the application PRI. Publish the
    resources produced for this exact configuration/runtime instead of globbing
    TargetDir, where stale outputs from removed XAML pages could remain.
  -->
  <Target Name="AddWinUIApplicationResourcesToPublish"
          AfterTargets="ComputeResolvedFilesToPublishList"
          DependsOnTargets="_GenerateProjectPriFile;ComputeProcessXamlFiles"
          Condition="'$(UseWinUI)' == 'true' and '$(WindowsPackageType)' == 'None'">
    <ItemGroup>
      <_WinUIApplicationXbf Include="@(ProcessedXamlFiles)"
                            Condition="'%(Extension)' == '.xbf'" />
    </ItemGroup>

    <Error Condition="!Exists('$(ProjectPriFullPath)')"
           Text="WinUI application PRI was not generated at '$(ProjectPriFullPath)'." />
    <Error Condition="'@(_WinUIApplicationXbf)' == ''"
           Text="WinUI did not report any generated application XBF resources for publishing." />

    <AssignTargetPath Files="@(_WinUIApplicationXbf)" RootFolder="$(TargetDir)">
      <Output TaskParameter="AssignedFiles"
              ItemName="_WinUIApplicationXbfWithTargetPath" />
    </AssignTargetPath>

    <ItemGroup>
      <ResolvedFileToPublish Remove="$(ProjectPriFullPath)" />
      <ResolvedFileToPublish Include="$(ProjectPriFullPath)">
        <RelativePath>$(ProjectPriFileName)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>

      <ResolvedFileToPublish Remove="@(_WinUIApplicationXbfWithTargetPath)" />
      <ResolvedFileToPublish Include="@(_WinUIApplicationXbfWithTargetPath)">
        <RelativePath>%(_WinUIApplicationXbfWithTargetPath.TargetPath)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
