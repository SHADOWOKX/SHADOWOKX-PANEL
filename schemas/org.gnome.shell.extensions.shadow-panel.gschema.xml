<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="shadow-panel">
  <schema id="org.gnome.shell.extensions.shadow-panel" path="/org/gnome/shell/extensions/shadow-panel/">
    <key name="debug" type="b">
      <default>false</default>
      <summary>Enable debug logging</summary>
    </key>
    <key name="panel-placement" type="s">
      <choices>
        <choice value="left"/>
        <choice value="center"/>
        <choice value="right"/>
      </choices>
      <default>'right'</default>
      <summary>Top bar placement</summary>
    </key>
    <key name="show-top-bar-text" type="b">
      <default>true</default>
      <summary>Show values beside top bar summary icons</summary>
    </key>
    <key name="show-codex-summary" type="b">
      <default>true</default>
      <summary>Show Codex remaining usage in the top bar</summary>
    </key>
    <key name="show-weather-summary" type="b">
      <default>true</default>
      <summary>Show the current temperature in the top bar</summary>
    </key>
    <key name="show-notes-summary" type="b">
      <default>true</default>
      <summary>Show Quick Notes status in the top bar</summary>
    </key>
    <key name="remember-last-tab" type="b">
      <default>true</default>
      <summary>Remember the last selected module</summary>
    </key>
    <key name="last-selected-tab" type="s">
      <default>'codex'</default>
      <summary>Last selected module</summary>
    </key>
    <key name="default-tab" type="s">
      <choices>
        <choice value="codex"/>
        <choice value="weather"/>
        <choice value="notes"/>
      </choices>
      <default>'codex'</default>
      <summary>Default module</summary>
    </key>
    <key name="refresh-on-open" type="b">
      <default>true</default>
      <summary>Refresh stale providers when opening the popup</summary>
    </key>
    <key name="animations" type="b">
      <default>true</default>
      <summary>Enable subtle interface animations</summary>
    </key>
    <key name="density" type="s">
      <choices>
        <choice value="compact"/>
        <choice value="comfortable"/>
      </choices>
      <default>'comfortable'</default>
      <summary>Popup density</summary>
    </key>
    <key name="enabled-modules" type="as">
      <default>['codex', 'weather', 'notes']</default>
      <summary>Enabled modules</summary>
    </key>
    <key name="module-order" type="as">
      <default>['codex', 'weather', 'notes']</default>
      <summary>Module order</summary>
    </key>
    <key name="theme" type="s">
      <choices>
        <choice value="auto"/>
        <choice value="dark"/>
        <choice value="light"/>
      </choices>
      <default>'auto'</default>
      <summary>Color scheme</summary>
    </key>
    <key name="background-theme" type="s">
      <choices>
        <choice value="default"/>
        <choice value="claude-gray"/>
        <choice value="dark-graphite"/>
        <choice value="light-neutral"/>
        <choice value="custom"/>
      </choices>
      <default>'claude-gray'</default>
      <summary>Dashboard background treatment</summary>
    </key>
    <key name="custom-background" type="s">
      <default>'#30312f'</default>
      <summary>Custom dashboard background tint</summary>
    </key>
    <key name="accent-color" type="s">
      <choices>
        <choice value="purple"/>
        <choice value="blue"/>
        <choice value="cyan"/>
        <choice value="emerald"/>
        <choice value="orange"/>
        <choice value="red"/>
        <choice value="rose"/>
        <choice value="graphite"/>
        <choice value="custom"/>
      </choices>
      <default>'purple'</default>
      <summary>Accent color preset</summary>
    </key>
    <key name="custom-accent" type="s">
      <default>'#8b5cf6'</default>
      <summary>Custom accent color</summary>
    </key>
    <key name="codex-refresh-minutes" type="i">
      <range min="5" max="120"/>
      <default>15</default>
      <summary>Codex refresh interval in minutes</summary>
    </key>
    <key name="weather-location" type="s">
      <default>'Cairo, Egypt'</default>
      <summary>Weather location</summary>
    </key>
    <key name="weather-unit" type="s">
      <choices>
        <choice value="celsius"/>
        <choice value="fahrenheit"/>
      </choices>
      <default>'celsius'</default>
      <summary>Temperature unit</summary>
    </key>
    <key name="weather-refresh-minutes" type="i">
      <range min="15" max="180"/>
      <default>30</default>
      <summary>Weather refresh interval in minutes</summary>
    </key>
    <key name="obsidian-vault-path" type="s">
      <default>''</default>
      <summary>Absolute path to an Obsidian vault</summary>
    </key>
    <key name="obsidian-target-folder" type="s">
      <default>'Inbox/QuickNotes'</default>
      <summary>Relative destination folder inside the Obsidian vault</summary>
    </key>
    <key name="obsidian-filename-pattern" type="s">
      <default>'Shadow Note {date} {time}'</default>
      <summary>Filename pattern for notes exported to Obsidian</summary>
    </key>
    <key name="notes-save-mode" type="s">
      <choices>
        <choice value="local"/>
        <choice value="obsidian"/>
        <choice value="both"/>
      </choices>
      <default>'local'</default>
      <summary>Default destination for Quick Notes</summary>
    </key>
  </schema>
</schemalist>
